{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mantiq Lesson Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "concepts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exercise_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
